---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Center from '@/components/layout/Center.astro';
import UiIcon, { type IconName } from '@/components/ui/UiIcon.astro';
import HeroLabDemo from '@/components/home/HeroLabDemo.astro';
import { getPublishedCollection } from '@/utils/collections';

const everyLayoutEntries = await getPublishedCollection('every-layout');

interface PillarItem {
  icon: IconName;
  title: string;
  desc: string;
  href: string;
  badge: string;
}

const pillars: PillarItem[] = [
  {
    icon: 'every-layout',
    title: 'Every Layout Lab',
    desc: 'As 13 primitivas universais de Heydon Pickering & Andy Bell. Composição algorítmica e intrínseca sem breakpoints.',
    href: '/every-layout',
    badge: '13 primitivas',
  },
  {
    icon: 'css-moderno',
    title: 'CSS Moderno',
    desc: 'Nesting nativo, Cascade Layers, :has(), Container Queries, light-dark() e propriedades lógicas sem JS.',
    href: '/css-moderno',
    badge: '11 tópicos',
  },
  {
    icon: 'grid-lab',
    title: 'Grid Lab',
    desc: 'De minmax() com auto-fill e auto-fit até subgrid e mapeamento visual de template areas.',
    href: '/grid-lab',
    badge: '7 tópicos',
  },
  {
    icon: 'flexbox-lab',
    title: 'Flexbox Lab',
    desc: 'Domínio de flex-basis, quebra de linha suave, Holy Albatross, eixos e alinhamento com margin: auto.',
    href: '/flexbox-lab',
    badge: '6 tópicos',
  },
  {
    icon: 'container-query',
    title: 'Container Query Lab',
    desc: 'Size queries, style queries, unidades cqi/cqw e componentes verdadeiramente autocontidos.',
    href: '/container-query-lab',
    badge: '5 tópicos',
  },
  {
    icon: 'components',
    title: 'Component Library',
    desc: 'Buttons, Modals com <dialog>, Tabs nativas, Accordions modernos e Cards com subgrid.',
    href: '/components',
    badge: '10 guias',
  },
  {
    icon: 'snippets',
    title: 'Snippets Library',
    desc: 'Receitas prontas de CSS moderno para layout, tipografia, micro-interações e padrões de produção.',
    href: '/snippets',
    badge: '25 receitas',
  },
  {
    icon: 'cheatsheets',
    title: 'Cheatsheets',
    desc: 'Guias de consulta rápida para o dia a dia, otimizados para leitura ágil e impressão em folha A4.',
    href: '/cheatsheets',
    badge: '6 guias A4',
  },
  {
    icon: 'design-tokens',
    title: 'Design Tokens',
    desc: 'Arquitetura de tokens e decisões de design codificadas em variáveis nativas e escalas fluidas.',
    href: '/design-tokens',
    badge: '5 guias',
  },
];

const quickLinks = [
  { label: 'Every Layout', href: '/every-layout' },
  { label: 'CSS Moderno', href: '/css-moderno' },
  { label: 'Grid Lab', href: '/grid-lab' },
  { label: 'Snippets', href: '/snippets' },
];
---

<BaseLayout title="Home — Guia Técnico de CSS Moderno & Layout">
  <div class="home-page">
    <!-- Hero Editorial Técnico (sem glow genérico, busca + demo CSS ao vivo) -->
    <section class="hero-section">
      <Center max="860px">
        <div class="hero-inner stack" style="--stack-space: var(--space-s);">
          <a href="#pilares" class="hero-pill">
            <span class="pill-dot" aria-hidden="true"></span>
            <span>9 pilares · 13 primitivas · 88 guias</span>
            <UiIcon name="arrow-down" size={13} />
          </a>

          <h1 class="hero-title">
            Como o layout responde ao conteúdo, e não à tela.
          </h1>

          <p class="hero-desc text-lg text-muted">
            Referência técnica de CSS moderno e composição de layout. Consulte propriedades, primitivas e receitas prontas direto na busca.
          </p>

          <!-- Barra de Busca em Destaque (estilo Mintlify / GitBook) -->
          <div class="hero-search-wrap">
            <button
              type="button"
              class="hero-search-bar"
              data-open-search
              aria-label="Abrir busca rápida por conceitos, propriedades e snippets (Atalho: Cmd+K ou Ctrl+K)"
            >
              <span class="hero-search-left">
                <UiIcon name="search" size={18} class="hero-search-icon" />
                <span class="hero-search-placeholder">Buscar primitivas, subgrid, :has(), snippets...</span>
              </span>
              <kbd class="hero-search-kbd font-mono">⌘K</kbd>
            </button>
          </div>

          <!-- Acesso Rápido -->
          <div class="quick-links cluster" style="--cluster-space: var(--space-2xs); justify-content: center;">
            <span class="quick-links-label text-xs text-muted">Populares:</span>
            {quickLinks.map((item) => (
              <a href={item.href} class="quick-link-pill text-xs">
                {item.label}
              </a>
            ))}
          </div>

          <!-- Mini Laboratório Interativo (@container ao vivo) -->
          <HeroLabDemo />
        </div>
      </Center>
    </section>

    <div class="home-sections stack" style="--stack-space: var(--space-2xl);">
      <!-- Continuar Estudando (Últimos 3 guias em localStorage) -->
      <section class="recent-section" id="recent-section" style="display: none;">
        <Center max="1140px">
          <div class="stack" style="--stack-space: var(--space-s);">
            <div class="section-header">
              <div class="stack" style="--stack-space: 0.2rem;">
                <span class="section-kicker text-xs font-semibold text-accent">
                  <UiIcon name="clock" size={13} />
                  <span>Histórico local</span>
                </span>
                <h2 class="section-title">Continuar estudando</h2>
              </div>
            </div>
            <div id="recent-container" class="recent-grid"></div>
          </div>
        </Center>
      </section>

      <!-- Minha Segunda Memória (Favoritos do Usuário via LocalStorage) -->
      <section class="bookmarks-section" id="bookmarks-section" style="display: none;">
        <Center max="1140px">
          <div class="stack" style="--stack-space: var(--space-s);">
            <div class="section-header">
              <div class="stack" style="--stack-space: 0.2rem;">
                <span class="section-kicker text-xs font-semibold text-accent">
                  <UiIcon name="star" size={13} />
                  <span>Salvos localmente</span>
                </span>
                <h2 class="section-title">Minha Segunda Memória</h2>
              </div>
            </div>
            <div id="bookmarks-container" class="cluster" style="--cluster-space: var(--space-2xs);"></div>
          </div>
        </Center>
      </section>

      <script>
        interface BookmarkItem {
          title: string;
          url: string;
        }

        interface RecentItem {
          title: string;
          url: string;
          section: string;
        }

        function isSafeLocalUrl(val: unknown): val is string {
          return typeof val === 'string' && val.startsWith('/') && !val.startsWith('//');
        }

        function isValidBookmark(item: unknown): item is BookmarkItem {
          if (!item || typeof item !== 'object') return false;
          const candidate = item as Record<string, unknown>;
          return isSafeLocalUrl(candidate.url) && typeof candidate.title === 'string';
        }

        function isValidRecent(item: unknown): item is RecentItem {
          if (!item || typeof item !== 'object') return false;
          const candidate = item as Record<string, unknown>;
          return (
            isSafeLocalUrl(candidate.url) &&
            typeof candidate.title === 'string' &&
            typeof candidate.section === 'string'
          );
        }

        function renderRecent(): void {
          try {
            const rawRecent = localStorage.getItem('css-lab-recent');
            const rawMastered = localStorage.getItem('css-lab-mastered');
            const section = document.getElementById('recent-section');
            const container = document.getElementById('recent-container');
            if (!section || !container) return;

            const parsedRecent: unknown = rawRecent ? JSON.parse(rawRecent) : [];
            const items = Array.isArray(parsedRecent) ? parsedRecent.filter(isValidRecent).slice(0, 3) : [];

            const parsedMastered: unknown = rawMastered ? JSON.parse(rawMastered) : [];
            const masteredUrls = new Set(
              Array.isArray(parsedMastered) ? parsedMastered.filter(isSafeLocalUrl) : []
            );

            if (items.length === 0) {
              section.style.display = 'none';
              container.replaceChildren();
              return;
            }

            section.style.display = 'block';
            const cards = items.map((item) => {
              const link = document.createElement('a');
              link.href = item.url;
              link.className = 'recent-card';

              const top = document.createElement('div');
              top.className = 'recent-top';

              const sec = document.createElement('span');
              sec.className = 'recent-section-tag font-mono text-xs';
              sec.textContent = item.section;
              top.append(sec);

              if (masteredUrls.has(item.url)) {
                const pill = document.createElement('span');
                pill.className = 'recent-mastered-pill font-mono text-xs';
                pill.textContent = 'Dominado';
                top.append(pill);
              }

              const titleEl = document.createElement('strong');
              titleEl.className = 'recent-title';
              titleEl.textContent = item.title;

              link.append(top, titleEl);
              return link;
            });

            container.replaceChildren(...cards);
          } catch {
            // Ignora JSON inválido ou bloqueio de storage
          }
        }

        function renderBookmarks(): void {
          try {
            const raw = localStorage.getItem('css-lab-bookmarks');
            const section = document.getElementById('bookmarks-section');
            const container = document.getElementById('bookmarks-container');
            if (!section || !container) return;

            const parsed: unknown = raw ? JSON.parse(raw) : [];
            const items = Array.isArray(parsed) ? parsed.filter(isValidBookmark) : [];

            if (items.length === 0) {
              section.style.display = 'none';
              container.replaceChildren();
              return;
            }

            section.style.display = 'block';
            const chips = items.map((item) => {
              const link = document.createElement('a');
              link.href = item.url;
              link.className = 'bookmark-chip';

              const dot = document.createElement('span');
              dot.className = 'bookmark-dot';
              dot.setAttribute('aria-hidden', 'true');

              const label = document.createElement('span');
              label.textContent = item.title;

              link.append(dot, label);
              return link;
            });

            container.replaceChildren(...chips);
          } catch {
            // Ignora JSON inválido ou bloqueio de storage
          }
        }

        function syncHomeLocalMemory(): void {
          renderRecent();
          renderBookmarks();
        }

        syncHomeLocalMemory();
        document.addEventListener('astro:page-load', syncHomeLocalMemory);
      </script>

      <!-- Pilares de Conhecimento (Cards Suaves estilo Mintlify) -->
      <section class="pillars-section" id="pilares">
        <Center max="1140px">
          <div class="stack" style="--stack-space: var(--space-m);">
            <div class="section-header">
              <div class="stack" style="--stack-space: 0.2rem;">
                <span class="section-kicker text-xs font-semibold text-accent">Explorar documentação</span>
                <h2 class="section-title">Pilares Fundamentais</h2>
              </div>
              <p class="section-subtitle text-sm text-muted">
                Escolha um pilar para consultar propriedades, exemplos e código pronto.
              </p>
            </div>

            <div class="pillars-grid">
              {pillars.map((pillar) => (
                <a href={pillar.href} class="pillar-card">
                  <div class="pillar-top">
                    <span class="pillar-icon-badge" aria-hidden="true">
                      <UiIcon name={pillar.icon} size={20} />
                    </span>
                    <span class="pillar-badge text-xs font-mono">{pillar.badge}</span>
                  </div>

                  <div class="pillar-content">
                    <h3 class="pillar-title">
                      <span>{pillar.title}</span>
                      <UiIcon name="arrow-right" size={15} class="pillar-arrow" />
                    </h3>
                    <p class="pillar-desc text-sm text-muted">{pillar.desc}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </Center>
      </section>

      <!-- Every Layout: As 13 Primitivas -->
      <section class="primitives-section">
        <Center max="1140px">
          <div class="stack" style="--stack-space: var(--space-m);">
            <div class="section-header">
              <div class="stack" style="--stack-space: 0.2rem;">
                <span class="section-kicker text-xs font-semibold text-accent">Every Layout</span>
                <h2 class="section-title">As 13 Primitivas de Layout</h2>
              </div>
              <a href="/every-layout" class="section-all-link text-sm font-medium">
                <span>Ver visão geral</span>
                <UiIcon name="arrow-right" size={14} />
              </a>
            </div>

            <div class="primitives-list" role="list">
              {everyLayoutEntries.map((entry) => (
                <a href={`/every-layout/${entry.id}`} class="primitive-row" role="listitem">
                  <span class="primitive-order font-mono text-xs text-muted">
                    {String(entry.data.order).padStart(2, '0')}
                  </span>
                  <strong class="primitive-name">{entry.data.title}</strong>
                  <span class="primitive-desc text-sm text-muted">{entry.data.problem}</span>
                  <div class="primitive-meta">
                    <span class="badge-difficulty font-mono text-xs">{entry.data.difficulty}</span>
                    <UiIcon name="arrow-right" size={14} class="primitive-arrow" />
                  </div>
                </a>
              ))}
            </div>
          </div>
        </Center>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-page {
    position: relative;
    overflow-x: clip;
    padding-block-end: var(--space-3xl);
  }

  /* ─── Hero Editorial Técnico ───────────────────────── */
  .hero-section {
    position: relative;
    padding-block: var(--space-xl) var(--space-l);
    padding-inline: var(--space-s);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    align-items: center;
    text-align: center;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    color: var(--color-fg-muted);
    font-size: var(--step--2);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-pill:hover {
      border-color: var(--color-border-hover);
      color: var(--color-text-strong);
      text-decoration: none;
    }
  }

  .pill-dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
  }

  .hero-title {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin: 0;
    max-inline-size: 22ch;
    color: var(--color-text-strong);
  }

  .hero-desc {
    max-inline-size: 56ch;
    margin: 0;
    line-height: 1.6;
  }

  /* Barra de Busca Principal */
  .hero-search-wrap {
    inline-size: 100%;
    max-inline-size: 540px;
    padding-block-start: var(--space-xs);
  }

  .hero-search-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    inline-size: 100%;
    padding: 0.8rem 1rem 0.8rem 1.1rem;
    border-radius: var(--radius-m);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-md);
    color: var(--color-fg-muted);
    font-family: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    min-block-size: 48px;
    transition: border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                transform 120ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-search-bar:hover {
      border-color: var(--color-accent);
      color: var(--color-text-strong);
    }
  }

  .hero-search-left {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-inline-size: 0;
  }

  .hero-search-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .hero-search-placeholder {
    text-align: start;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-search-kbd {
    font-size: 0.78em;
    padding: 0.18em 0.5em;
    border-radius: var(--radius-s);
    background-color: var(--color-bg-inset);
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    flex-shrink: 0;
  }

  /* Quick Links */
  .quick-links {
    align-items: center;
    padding-block-start: 0.25rem;
  }

  .quick-link-pill {
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-inset);
    color: var(--color-fg-muted);
    text-decoration: none;
    font-weight: 500;
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .quick-link-pill:hover {
      background-color: var(--color-accent-muted);
      color: var(--color-accent);
      text-decoration: none;
    }
  }

  /* ─── Seções Principais ────────────────────────────── */
  .home-sections {
    padding-inline: var(--space-s);
  }

  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .section-title {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .section-subtitle {
    margin: 0;
  }

  .section-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .section-all-link:hover {
      color: var(--color-accent-hover);
      text-decoration: none;
    }
  }

  /* ─── Continuar Estudando (Recentes) ───────────────── */
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-s);
  }

  :global(.recent-card) {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-m);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) ease,
                background-color var(--duration-fast) ease,
                box-shadow var(--duration-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.recent-card:hover) {
      border-color: var(--color-border-hover);
      background-color: var(--color-surface-hover);
      box-shadow: var(--shadow-md);
      text-decoration: none;
    }
  }

  :global(.recent-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  :global(.recent-section-tag) {
    color: var(--color-fg-muted);
  }

  :global(.recent-mastered-pill) {
    padding: 0.1em 0.5em;
    border-radius: var(--radius-full);
    color: var(--color-success);
    background-color: var(--color-success-muted);
    font-weight: 600;
  }

  :global(.recent-title) {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--color-text-strong);
    line-height: 1.3;
    transition: color var(--duration-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.recent-card:hover .recent-title) {
      color: var(--color-accent);
    }
  }

  /* ─── Bookmarks ────────────────────────────────────── */
  :global(.bookmark-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.38rem 0.8rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    color: var(--color-fg);
    text-decoration: none;
    font-size: var(--step--1);
    transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.bookmark-chip:hover) {
      border-color: var(--color-accent);
      color: var(--color-accent);
      text-decoration: none;
    }
  }

  :global(.bookmark-dot) {
    inline-size: 6px;
    block-size: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ─── Cards dos 9 Pilares (Mintlify Soft Cards) ────── */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 310px), 1fr));
    gap: var(--space-m);
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out),
                background-color var(--duration-normal) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .pillar-card:hover {
      border-color: var(--color-border-hover);
      background-color: var(--color-surface-hover);
      box-shadow: var(--shadow-md);
      text-decoration: none;
    }
  }

  .pillar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .pillar-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 10px;
    background-color: var(--color-accent-muted);
    color: var(--color-accent);
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pillar-card:hover .pillar-icon-badge {
      background-color: var(--color-accent);
      color: var(--color-on-accent);
    }
  }

  .pillar-badge {
    padding: 0.2em 0.6em;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-inset);
    color: var(--color-fg-muted);
  }

  .pillar-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pillar-title {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
