---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Center from '@/components/layout/Center.astro';
import { getPublishedCollection } from '@/utils/collections';

const entries = await getPublishedCollection('grid-lab');
---

<BaseLayout
  title="Grid Lab — Layout em Duas Dimensões"
  description="Guia prático de CSS Grid: linhas, colunas, template areas, auto-fill com minmax, alinhamentos e subgrid."
>
  <div class="hub-container">
    <Center max="1100px">
      <div class="stack" style="--stack-space: var(--space-xl);">
        <header class="hub-header stack" style="--stack-space: var(--space-xs);">
          <div class="cluster" style="--cluster-space: var(--space-xs); align-items: center;">
            <span class="hub-badge font-mono text-xs">Base de Layout</span>
            <span class="text-xs text-muted">Linhas e colunas</span>
          </div>
          <h1 class="hub-title">Grid Lab</h1>
          <p class="hub-desc text-lg text-muted">
            Controle linhas e colunas ao mesmo tempo. Aprenda a criar grades responsivas com minmax(), organizar seções com template-areas e alinhar cards com subgrid.
          </p>
        </header>

        <div class="axiom-banner">
          <span class="text-xs font-semibold tracking-caps text-muted">Quando usar Grid</span>
          <blockquote class="axiom-quote">
            "Use Flexbox para organizar itens em uma única direção. Use Grid quando precisar alinhar elementos em linhas e colunas ao mesmo tempo."
          </blockquote>
        </div>

        <!-- Grid de Cards Proporcionais -->
        <div class="hub-cards-grid">
          {entries.map((entry) => (
            <a href={`/grid-lab/${entry.id}`} class="hub-card-link">
              <article class="hub-card">
                <header class="hub-card-header">
                  <span class="hub-card-order font-mono text-xs text-muted">#{String(entry.data.order).padStart(2, '0')}</span>
                  <h2 class="hub-card-title">{entry.data.title}</h2>
                </header>
                <div class="hub-card-body">
                  <p class="hub-card-desc text-sm text-muted">{entry.data.description}</p>
                </div>
                <footer class="hub-card-footer">
                  <span class="badge-difficulty font-mono text-xs">{entry.data.difficulty}</span>
                  <span class="hub-card-arrow" aria-hidden="true">Acessar →</span>
                </footer>
              </article>
            </a>
          ))}
        </div>
      </div>
    </Center>
  </div>
</BaseLayout>
