---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Center from '@/components/layout/Center.astro';
import { getPublishedCollection } from '@/utils/collections';

const entries = await getPublishedCollection('flexbox-lab');
---

<BaseLayout
  title="Flexbox Lab — Distribuição Unidimensional e Dinâmica"
  description="Laboratório aprofundado de CSS Flexbox: eixos, flex-grow, flex-shrink, flex-basis, alinhamentos, quebra e padrões."
>
  <div class="hub-container">
    <Center max="1100px">
      <div class="stack" style="--stack-space: var(--space-xl);">
        <header class="hub-header stack" style="--stack-space: var(--space-xs);">
          <div class="cluster" style="--cluster-space: var(--space-xs); align-items: center;">
            <span class="hub-badge font-mono text-xs">Pilar Unidimensional</span>
            <span class="text-xs text-muted">Distribuição de Conteúdo</span>
          </div>
          <h1 class="hub-title">Flexbox Lab</h1>
          <p class="hub-desc text-lg text-muted">
            Distribuição fluida ao longo de um eixo. Entenda o algoritmo de flexibilidade intrínseca, a física por trás de flex-basis e como margin auto opera milagres de espaçamento.
          </p>
        </header>

        <div class="axiom-banner">
          <span class="text-xs font-semibold tracking-caps text-muted">Axioma Unidimensional</span>
          <blockquote class="axiom-quote">
            "Flexbox não tenta controlar uma página inteira como uma matriz rígida. Ele cuida de componentes lineares, adaptando o tamanho de cada elemento à sua carga de conteúdo."
          </blockquote>
        </div>

        <!-- Grid de Cards Proporcionais -->
        <div class="hub-cards-grid">
          {entries.map((entry) => (
            <a href={`/flexbox-lab/${entry.id}`} class="hub-card-link">
              <article class="hub-card">
                <header class="hub-card-header">
                  <span class="hub-card-order font-mono text-xs text-muted">#{String(entry.data.order).padStart(2, '0')}</span>
                  <h2 class="hub-card-title">{entry.data.title}</h2>
                </header>
                <div class="hub-card-body">
                  <p class="hub-card-desc text-sm text-muted">{entry.data.description}</p>
                </div>
                <footer class="hub-card-footer">
                  <span class="badge-difficulty font-mono text-xs">{entry.data.difficulty}</span>
                  <span class="hub-card-arrow" aria-hidden="true">Acessar →</span>
                </footer>
              </article>
            </a>
          ))}
        </div>
      </div>
    </Center>
  </div>
</BaseLayout>
