---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Center from '@/components/layout/Center.astro';
import { getPublishedCollection } from '@/utils/collections';

const entries = await getPublishedCollection('every-layout');
---

<BaseLayout
  title="Every Layout Lab — As 13 Primitivas de Layout"
  description="Documentação das 13 primitivas de layout do Every Layout para construir interfaces que se adaptam ao conteúdo."
>
  <div class="hub-container">
    <Center max="1100px">
      <div class="stack" style="--stack-space: var(--space-xl);">
        <header class="hub-header stack" style="--stack-space: var(--space-xs);">
          <div class="cluster" style="--cluster-space: var(--space-xs); align-items: center;">
            <span class="hub-badge font-mono text-xs">Pilar Central</span>
            <span class="text-xs text-muted">Heydon Pickering & Andy Bell</span>
          </div>
          <h1 class="hub-title">Every Layout Lab</h1>
          <p class="hub-desc text-lg text-muted">
            13 primitivas simples que você combina para montar páginas inteiras. Em vez de escrever dezenas de breakpoints manuais, o layout usa regras matemáticas do próprio CSS.
          </p>
        </header>

        <div class="axiom-banner">
          <span class="text-xs font-semibold tracking-caps text-accent">Ideia central</span>
          <blockquote class="axiom-quote">
            "Combine peças simples que resolvem um problema de espaço cada uma. Juntas, elas cobrem quase qualquer layout real."
          </blockquote>
        </div>

        <!-- Grid de Cards Perfeitamente Proporcionais -->
        <div class="hub-cards-grid">
          {entries.map((entry) => (
            <a href={`/every-layout/${entry.id}`} class="hub-card-link">
              <article class="hub-card">
                <header class="hub-card-header">
                  <span class="hub-card-order font-mono text-xs text-muted">#{String(entry.data.order).padStart(2, '0')}</span>
                  <h2 class="hub-card-title">{entry.data.title}</h2>
                </header>
                <div class="hub-card-body">
                  <p class="hub-card-desc text-sm text-muted">{entry.data.problem}</p>
                </div>
                <footer class="hub-card-footer">
                  <span class="badge-difficulty font-mono text-xs">{entry.data.difficulty}</span>
                  <span class="hub-card-arrow" aria-hidden="true">Acessar →</span>
                </footer>
              </article>
            </a>
          ))}
        </div>
      </div>
    </Center>
  </div>
</BaseLayout>
