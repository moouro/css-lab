---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Center from '@/components/layout/Center.astro';
import { getPublishedCollection } from '@/utils/collections';

const entries = await getPublishedCollection('components');
---

<BaseLayout
  title="Component Library — Engenharia de Componentes Modernos"
  description="Biblioteca de componentes nativos construídos sobre Every Layout, HTML semântico e CSS moderno sem dependência excessiva de JavaScript."
>
  <div class="hub-container">
    <Center max="1100px">
      <div class="stack" style="--stack-space: var(--space-xl);">
        <header class="hub-header stack" style="--stack-space: var(--space-xs);">
          <div class="cluster" style="--cluster-space: var(--space-xs); align-items: center;">
            <span class="hub-badge font-mono text-xs">Pilar de Componentes</span>
            <span class="text-xs text-muted">HTML Semântico & Every Layout</span>
          </div>
          <h1 class="hub-title">Component Library</h1>
          <p class="hub-desc text-lg text-muted">
            Componentes robustos, acessíveis e elegantes. Construídos com elementos nativos da plataforma web (<code>&lt;dialog&gt;</code>, <code>&lt;details&gt;</code>, <code>popover</code>), primitivas de layout e micro-interações refinadas.
          </p>
        </header>

        <div class="axiom-banner">
          <span class="text-xs font-semibold tracking-caps text-muted">Axioma de Componentes</span>
          <blockquote class="axiom-quote">
            "Use a plataforma primeiro. O melhor JavaScript é aquele que você não precisou escrever porque o navegador já possui uma tag nativa para a função com acessibilidade integrada."
          </blockquote>
        </div>

        <!-- Grid de Cards Proporcionais -->
        <div class="hub-cards-grid">
          {entries.map((entry) => (
            <a href={`/components/${entry.id}`} class="hub-card-link">
              <article class="hub-card">
                <header class="hub-card-header">
                  <span class="hub-card-order font-mono text-xs text-muted">#{String(entry.data.order).padStart(2, '0')}</span>
                  <h2 class="hub-card-title">{entry.data.title}</h2>
                </header>
                <div class="hub-card-body">
                  <p class="hub-card-desc text-sm text-muted">{entry.data.description}</p>
                </div>
                <footer class="hub-card-footer">
                  <span class="badge-difficulty font-mono text-xs">{entry.data.difficulty}</span>
                  <span class="hub-card-arrow" aria-hidden="true">Acessar →</span>
                </footer>
              </article>
            </a>
          ))}
        </div>
      </div>
    </Center>
  </div>
</BaseLayout>
