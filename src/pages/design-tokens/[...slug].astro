---
import DocLayout from '@/layouts/DocLayout.astro';
import { render } from 'astro:content';
import { getPublishedCollection } from '@/utils/collections';

export async function getStaticPaths() {
  const entries = await getPublishedCollection('design-tokens');
  const sidebarItems = entries.map((item) => ({
    slug: item.id,
    title: item.data.title,
    order: item.data.order,
  }));

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, sidebarItems },
  }));
}

const { entry, sidebarItems } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  collectionName="Design Tokens"
  collectionSlug="design-tokens"
  items={sidebarItems}
  headings={headings}
>
  <Content />
</DocLayout>
