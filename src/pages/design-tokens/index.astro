---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Center from '@/components/layout/Center.astro';
import { getPublishedCollection } from '@/utils/collections';

const entries = await getPublishedCollection('design-tokens');
---

<BaseLayout
  title="Design Tokens — Variáveis Visuais em CSS"
  description="Como estruturar cores com light-dark(), escala tipográfica com clamp(), espaçamentos, bordas e sombras em CSS puro."
>
  <div class="hub-container">
    <Center max="1100px">
      <div class="stack" style="--stack-space: var(--space-xl);">
        <header class="hub-header stack" style="--stack-space: var(--space-xs);">
          <div class="cluster" style="--cluster-space: var(--space-xs); align-items: center;">
            <span class="hub-badge font-mono text-xs">Fundações</span>
            <span class="text-xs text-muted">Variáveis CSS nativas</span>
          </div>
          <h1 class="hub-title">Design Tokens</h1>
          <p class="hub-desc text-lg text-muted">
            Todas as cores, tamanhos de fonte, espaçamentos e bordas definidos em CSS Custom Properties — com suporte nativo a modo claro e escuro.
          </p>
        </header>

        <div class="axiom-banner">
          <span class="text-xs font-semibold tracking-caps text-muted">Ideia central</span>
          <blockquote class="axiom-quote">
            "Centralizar valores visuais em variáveis permite ajustar tema, contraste e ritmo do site inteiro alterando poucos tokens."
          </blockquote>
        </div>

        <!-- Grid de Cards Proporcionais -->
        <div class="hub-cards-grid">
          {entries.map((entry) => (
            <a href={`/design-tokens/${entry.id}`} class="hub-card-link">
              <article class="hub-card">
                <header class="hub-card-header">
                  <span class="hub-card-order font-mono text-xs text-muted">#{String(entry.data.order).padStart(2, '0')}</span>
                  <h2 class="hub-card-title">{entry.data.title}</h2>
                </header>
                <div class="hub-card-body">
                  <p class="hub-card-desc text-sm text-muted">{entry.data.description}</p>
                </div>
                <footer class="hub-card-footer">
                  <span class="badge-difficulty font-mono text-xs capitalize">{entry.data.category}</span>
                  <span class="hub-card-arrow" aria-hidden="true">Explorar →</span>
                </footer>
              </article>
            </a>
          ))}
        </div>
      </div>
    </Center>
  </div>
</BaseLayout>
