---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Center from '@/components/layout/Center.astro';
import { getPublishedCollection } from '@/utils/collections';

const entries = await getPublishedCollection('cheatsheets');
---

<BaseLayout
  title="Cheatsheets — Referência Rápida & Pronta para Impressão"
  description="Guias condensados de CSS moderno para consulta relâmpago durante o expediente: Grid, Flexbox, Seletores, Unidades e Funções."
>
  <div class="hub-container">
    <Center max="1100px">
      <div class="stack" style="--stack-space: var(--space-xl);">
        <header class="hub-header stack" style="--stack-space: var(--space-xs);">
          <div class="cluster" style="--cluster-space: var(--space-xs); align-items: center;">
            <span class="hub-badge font-mono text-xs">Pilar de Referência</span>
            <span class="text-xs text-muted">Layouts Condensados & Otimizados para Impressão</span>
          </div>
          <h1 class="hub-title">Cheatsheets</h1>
          <p class="hub-desc text-lg text-muted">
            Tabelas e resumos de bolso para consulta diária. Otimizados para visualização rápida no segundo monitor ou impressão direta em folha A4.
          </p>
        </header>

        <div class="axiom-banner">
          <span class="text-xs font-semibold tracking-caps text-muted">Axioma de Produtividade</span>
          <blockquote class="axiom-quote">
            "A melhor documentação de consulta rápida é aquela que cabe em uma única tela ou folha física, sintetizando regras complexas em sintaxes diretas sem rodeios."
          </blockquote>
        </div>

        <!-- Grid de Cards Proporcionais -->
        <div class="hub-cards-grid">
          {entries.map((entry) => (
            <a href={`/cheatsheets/${entry.id}`} class="hub-card-link">
              <article class="hub-card">
                <header class="hub-card-header">
                  <span class="hub-card-order font-mono text-xs text-muted">#{String(entry.data.order).padStart(2, '0')}</span>
                  <h2 class="hub-card-title">{entry.data.title}</h2>
                </header>
                <div class="hub-card-body">
                  <p class="hub-card-desc text-sm text-muted">{entry.data.description}</p>
                </div>
                <footer class="hub-card-footer">
                  <span class="badge-difficulty font-mono text-xs">Print A4</span>
                  <span class="hub-card-arrow" aria-hidden="true">Consultar →</span>
                </footer>
              </article>
            </a>
          ))}
        </div>
      </div>
    </Center>
  </div>
</BaseLayout>
