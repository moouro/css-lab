---
import DocLayout from '@/layouts/DocLayout.astro';
import { render } from 'astro:content';
import { getPublishedCollection } from '@/utils/collections';

export async function getStaticPaths() {
  const entries = await getPublishedCollection('cheatsheets');
  const sidebarItems = entries.map((item) => ({
    slug: item.id,
    title: item.data.title,
    order: item.data.order,
  }));

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, sidebarItems },
  }));
}

const { entry, sidebarItems } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  collectionName="Cheatsheets"
  collectionSlug="cheatsheets"
  items={sidebarItems}
  headings={headings}
  tags={entry.data.tags}
>
  <div class="cheatsheet-toolbar no-print">
    <button type="button" class="btn-print" data-print-cheatsheet>
      <span aria-hidden="true">🖨️</span> Imprimir / Salvar em PDF (A4)
    </button>
  </div>
  <Content />
</DocLayout>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (target?.closest('[data-print-cheatsheet]')) {
      window.print();
    }
  });
</script>

<style>
  .cheatsheet-toolbar {
    display: flex;
    justify-content: flex-end;
    margin-block-end: var(--space-m);
  }

  .btn-print {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .btn-print:hover {
    background-color: var(--color-bg-hover);
    border-color: var(--color-border-hover);
  }

  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>
