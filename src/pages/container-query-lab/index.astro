---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Center from '@/components/layout/Center.astro';
import { getPublishedCollection } from '@/utils/collections';

const entries = await getPublishedCollection('container-query-lab');
---

<BaseLayout
  title="Container Query Lab — Componentes que Respondem ao Espaço"
  description="Guia prático de Container Queries (@container): size queries, style queries, unidades cqi/cqw e padrões de componentes."
>
  <div class="hub-container">
    <Center max="1100px">
      <div class="stack" style="--stack-space: var(--space-xl);">
        <header class="hub-header stack" style="--stack-space: var(--space-xs);">
          <div class="cluster" style="--cluster-space: var(--space-xs); align-items: center;">
            <span class="hub-badge font-mono text-xs">Componentes</span>
            <span class="text-xs text-muted">@container</span>
          </div>
          <h1 class="hub-title">Container Query Lab</h1>
          <p class="hub-desc text-lg text-muted">
            Com Container Queries, um card ou bloco adapta o próprio visual ao tamanho do espaço onde foi colocado — seja numa barra lateral estreita ou na área principal.
          </p>
        </header>

        <div class="axiom-banner">
          <span class="text-xs font-semibold tracking-caps text-muted">Ideia central</span>
          <blockquote class="axiom-quote">
            "Um componente não precisa saber o tamanho da tela inteira; só precisa saber quanto espaço recebeu do container pai."
          </blockquote>
        </div>

        <!-- Grid de Cards Proporcionais -->
        <div class="hub-cards-grid">
          {entries.map((entry) => (
            <a href={`/container-query-lab/${entry.id}`} class="hub-card-link">
              <article class="hub-card">
                <header class="hub-card-header">
                  <span class="hub-card-order font-mono text-xs text-muted">#{String(entry.data.order).padStart(2, '0')}</span>
                  <h2 class="hub-card-title">{entry.data.title}</h2>
                </header>
                <div class="hub-card-body">
                  <p class="hub-card-desc text-sm text-muted">{entry.data.description}</p>
                </div>
                <footer class="hub-card-footer">
                  <span class="badge-difficulty font-mono text-xs">{entry.data.difficulty}</span>
                  <span class="hub-card-arrow" aria-hidden="true">Acessar →</span>
                </footer>
              </article>
            </a>
          ))}
        </div>
      </div>
    </Center>
  </div>
</BaseLayout>
