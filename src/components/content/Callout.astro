---
import UiIcon, { type IconName } from '../ui/UiIcon.astro';

export interface Props {
  type?: 'tip' | 'warning' | 'info' | 'important';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const iconMap: Record<NonNullable<Props['type']>, IconName> = {
  tip: 'tip',
  warning: 'warning',
  info: 'info',
  important: 'zap',
};
---

<aside class:list={['callout', `callout-${type}`]}>
  <div class="callout-header">
    <span class="callout-icon" aria-hidden="true">
      <UiIcon name={iconMap[type]} size={16} />
    </span>
    <strong class="callout-title">{title || type.toUpperCase()}</strong>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    padding: var(--space-s);
    border-radius: var(--radius-m);
    border: 1px solid var(--color-border);
    border-inline-start: 3px solid var(--callout-border);
    background-color: var(--callout-bg);
    margin-block: var(--space-m);
  }

  .callout-info {
    --callout-border: var(--color-accent);
    --callout-bg: var(--accent-muted);
  }

  .callout-warning {
    --callout-border: var(--color-warning);
    --callout-bg: var(--color-warning-muted);
  }

  .callout-tip {
    --callout-border: var(--color-success);
    --callout-bg: var(--color-success-muted);
  }

  .callout-important {
    --callout-border: light-dark(#7c3aed, #a78bfa);
    --callout-bg: light-dark(rgb(124 58 237 / 0.08), rgb(167 139 250 / 0.12));
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-3xs);
  }

  .callout-icon {
    display: inline-flex;
    align-items: center;
    color: var(--callout-border);
    flex-shrink: 0;
  }

  .callout-title {
    font-size: var(--step--1);
    color: var(--color-text-strong);
    letter-spacing: var(--tracking-wide);
  }

  .callout-body {
    font-size: var(--step--1);
    color: var(--color-text);
  }
</style>
