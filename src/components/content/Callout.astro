---
export interface Props {
  type?: 'tip' | 'warning' | 'info' | 'important';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const icons = {
  tip: '💡',
  warning: '⚠️',
  info: 'ℹ️',
  important: '⚡'
};
---

<aside class:list={['callout', `callout-${type}`]}>
  <div class="callout-header">
    <span class="callout-icon" aria-hidden="true">{icons[type]}</span>
    <strong class="callout-title">{title || type.toUpperCase()}</strong>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    padding: var(--space-s);
    border-radius: var(--radius-m);
    border-inline-start: 4px solid var(--callout-border);
    background-color: var(--callout-bg);
    margin-block: var(--space-m);
  }

  .callout-info {
    --callout-border: var(--color-accent);
    --callout-bg: var(--accent-muted);
  }

  .callout-warning {
    --callout-border: var(--color-warning);
    --callout-bg: var(--color-warning-muted);
  }

  .callout-tip {
    --callout-border: var(--color-success);
    --callout-bg: var(--color-success-muted);
  }

  .callout-important {
    --callout-border: #a855f7;
    --callout-bg: oklch(0.6 0.2 300 / 0.1);
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-3xs);
  }

  .callout-title {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
  }

  .callout-body {
    font-size: var(--step--1);
    color: var(--color-text);
  }
</style>
