---
import UiIcon from '../ui/UiIcon.astro';

export interface Props {
  items: string[];
}

const { items = [] } = Astro.props;
---

<div class="checklist-card stack" style="--stack-space: var(--space-xs);">
  <h4 class="text-sm font-semibold tracking-caps text-muted">Checklist de Resiliência</h4>
  <ul class="checklist stack" style="--stack-space: var(--space-2xs);">
    {items.map((item) => (
      <li class="checklist-item">
        <span class="check-icon-wrap" aria-hidden="true">
          <UiIcon name="check" size={15} class="check-icon" />
        </span>
        <span class="checklist-text text-sm">{item}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .checklist-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    padding: var(--space-m);
    background-color: var(--color-bg-surface);
    box-shadow: var(--shadow-sm);
    margin-block: var(--space-m);
  }

  .checklist {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .checklist-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-xs);
    align-items: start;
  }

  .check-icon-wrap {
    display: inline-flex;
    align-items: center;
    padding-block-start: 0.2rem;
    color: var(--color-success);
  }

  .checklist-text {
    line-height: 1.5;
  }
</style>
