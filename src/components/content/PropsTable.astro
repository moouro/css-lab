---
export interface Props {
  props: Array<{
    name: string;
    type: string;
    default?: string;
    description: string;
  }>;
}

const { props = [] } = Astro.props;
---

<div class="props-table-wrapper">
  <table class="props-table">
    <thead>
      <tr>
        <th scope="col">Prop / Atributo</th>
        <th scope="col">Tipo</th>
        <th scope="col">Padrão</th>
        <th scope="col">Descrição</th>
      </tr>
    </thead>
    <tbody>
      {props.map((p) => (
        <tr>
          <td><code class="prop-name">{p.name}</code></td>
          <td><code class="prop-type">{p.type}</code></td>
          <td>{p.default ? <code>{p.default}</code> : <span class="text-subtle">—</span>}</td>
          <td>{p.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .props-table-wrapper {
    overflow-x: auto;
    margin-block: var(--space-m);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-m);
  }

  .props-table {
    inline-size: 100%;
    font-size: var(--step--1);
  }

  .props-table th {
    text-align: start;
    padding: var(--space-xs) var(--space-s);
    background-color: var(--color-bg-raised);
    border-block-end: var(--border-thin) solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }

  .props-table td {
    padding: var(--space-xs) var(--space-s);
    border-block-end: var(--border-thin) solid var(--color-border);
    vertical-align: top;
  }

  .props-table tr:last-child td {
    border-block-end: none;
  }

  .prop-name {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
  }

  .prop-type {
    color: var(--color-text-muted);
  }
</style>
