---
export interface Props {
  props: Array<{
    name: string;
    type: string;
    default?: string;
    description: string;
  }>;
}

const { props = [] } = Astro.props;
---

<div class="props-table-wrapper" tabindex="0" role="region" aria-label="Tabela de Props e Atributos">
  <table class="props-table">
    <thead>
      <tr>
        <th scope="col">Prop / Atributo</th>
        <th scope="col">Tipo</th>
        <th scope="col">Padrão</th>
        <th scope="col">Descrição</th>
      </tr>
    </thead>
    <tbody>
      {props.map((p) => (
        <tr class="props-row">
          <td data-label="Prop"><code class="prop-name">{p.name}</code></td>
          <td data-label="Tipo"><code class="prop-type">{p.type}</code></td>
          <td data-label="Padrão">{p.default ? <code>{p.default}</code> : <span class="text-subtle">—</span>}</td>
          <td data-label="Descrição" class="prop-desc">{p.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .props-table-wrapper {
    margin-block: var(--space-m);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-m);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background-color: var(--color-bg-surface);
  }

  .props-table {
    inline-size: 100%;
    min-inline-size: 540px;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .props-table th {
    text-align: start;
    padding: var(--space-xs) var(--space-s);
    background-color: var(--color-bg-raised);
    border-block-end: var(--border-thin) solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .props-table td {
    padding: var(--space-xs) var(--space-s);
    border-block-end: var(--border-thin) solid var(--color-border);
    vertical-align: top;
  }

  .props-table tr:last-child td {
    border-block-end: none;
  }

  .prop-name {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    overflow-wrap: normal;
  }

  .prop-type {
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow-wrap: normal;
  }

  /* ═══ Transformação Responsiva em Cards (Modern Web Guidance) ═══
     Em telas estreitas (<= 640px), transforma linhas tabulares em cards
     verticais independentes, impedindo que textos se quebrem letra por letra.
     ══════════════════════════════════════════════════════════════ */
  @media (max-width: 640px) {
    .props-table-wrapper {
      border: none;
      background: transparent;
      overflow-x: visible;
      margin-block: var(--space-s);
    }

    .props-table {
      min-inline-size: 100%;
      display: block;
    }

    .props-table thead {
      display: none; /* Esconde cabeçalho fixo na versão card */
    }

    .props-table tbody {
      display: flex;
      flex-direction: column;
      gap: var(--space-s);
    }

    .props-row {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      padding: var(--space-s);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background-color: var(--color-bg-surface);
      box-shadow: var(--shadow-sm);
    }

    .props-row td {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-s);
      padding: 0;
      border: none;
      font-size: var(--step--1);
    }

    .props-row td::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: var(--step--2);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-fg-muted);
      flex-shrink: 0;
    }

    .props-row td.prop-desc {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3xs);
      border-block-start: 1px dashed var(--color-border);
      padding-block-start: var(--space-2xs);
      margin-block-start: var(--space-3xs);
    }

    .props-row td.prop-desc::before {
      margin-block-end: 2px;
    }
  }
</style>
