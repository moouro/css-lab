---
import UiIcon from '../ui/UiIcon.astro';

export interface Props {
  badCode: string;
  goodCode: string;
  explanation: string;
}

const { badCode, goodCode, explanation } = Astro.props;
---

<div class="antipattern-box stack" style="--stack-space: var(--space-xs);">
  <div class="antipattern-header">
    <span class="bad-tag">
      <UiIcon name="x-circle" size={16} />
      <span>Anti-pattern</span>
    </span>
    <span class="vs">vs</span>
    <span class="good-tag">
      <UiIcon name="check-circle" size={16} />
      <span>Solução Resiliente</span>
    </span>
  </div>

  <div class="code-comparison">
    <div class="code-pane bad">
      <div class="pane-label">Frágil / Imperativo</div>
      <pre><code>{badCode}</code></pre>
    </div>
    <div class="code-pane good">
      <div class="pane-label">Resiliente / Intrínseco</div>
      <pre><code>{goodCode}</code></pre>
    </div>
  </div>

  <p class="explanation text-sm text-muted">
    <strong>Por que evitar:</strong> {explanation}
  </p>
</div>

<style>
  .antipattern-box {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    padding: var(--space-s);
    background-color: var(--color-bg-surface);
    box-shadow: var(--shadow-sm);
    margin-block: var(--space-m);
  }

  .antipattern-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }

  .bad-tag,
  .good-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .bad-tag { color: var(--color-error); }
  .good-tag { color: var(--color-success); }
  .vs { color: var(--color-text-subtle); }

  .code-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-xs);
  }

  .code-pane {
    border-radius: var(--radius-m);
    overflow: hidden;
    border: 1px solid var(--color-border);
    min-inline-size: 0;
    inline-size: 100%;
    background-color: var(--color-bg-inset);
  }

  .pane-label {
    font-size: var(--step--2);
    font-family: var(--font-mono);
    padding: 0.35rem 0.65rem;
    background-color: var(--color-bg-raised);
    border-block-end: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .code-pane pre {
    margin: 0;
    border: none;
    border-radius: 0;
    max-inline-size: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    font-size: var(--step--1);
  }

  .explanation {
    margin: 0;
  }

  @media (max-width: 640px) {
    .antipattern-box {
      padding: var(--space-xs);
      margin-block: var(--space-s);
    }
    .code-comparison {
      grid-template-columns: 1fr;
    }
  }
</style>
