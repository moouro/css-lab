---
import UiIcon from '../ui/UiIcon.astro';
---

<footer class="site-footer">
  <div class="footer-inner cluster" style="--cluster-space: var(--space-m); --cluster-justify: space-between; --cluster-align: flex-start;">
    <div class="stack" style="--stack-space: var(--space-3xs);">
      <span class="footer-brand font-mono">
        <UiIcon name="brand" size={16} class="footer-brand-icon" />
        <span>CSS Lab</span>
      </span>
      <p class="text-sm text-muted">
        Referência técnica de CSS moderno e layout intrínseco.
      </p>
      <p class="text-xs text-subtle">
        Baseado nos princípios de <em>Every Layout (3ª Edição)</em>, de Heydon Pickering e Andy Bell.
      </p>
    </div>

    <div class="cluster" style="--cluster-space: var(--space-l);">
      <div class="stack" style="--stack-space: var(--space-3xs);">
        <span class="text-xs font-semibold tracking-caps text-muted">Pilares</span>
        <a href="/every-layout" class="footer-link">Every Layout</a>
        <a href="/css-moderno" class="footer-link">CSS Moderno</a>
        <a href="/grid-lab" class="footer-link">Grid Lab</a>
        <a href="/flexbox-lab" class="footer-link">Flexbox Lab</a>
        <a href="/container-query-lab" class="footer-link">Container Queries</a>
      </div>

      <div class="stack" style="--stack-space: var(--space-3xs);">
        <span class="text-xs font-semibold tracking-caps text-muted">Prática</span>
        <a href="/components" class="footer-link">Componentes</a>
        <a href="/snippets" class="footer-link">Snippets</a>
        <a href="/cheatsheets" class="footer-link">Cheatsheets</a>
        <a href="/design-tokens" class="footer-link">Design Tokens</a>
      </div>

      <div class="stack" style="--stack-space: var(--space-3xs);">
        <span class="text-xs font-semibold tracking-caps text-muted">Projeto</span>
        <a href="https://github.com/moouro/css-lab" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub (Open Source) ↗</a>
        <a href="https://github.com/moouro/css-lab/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="footer-link">Licença MIT ↗</a>
        <button type="button" class="footer-link-btn" data-open-search>Buscar no site (⌘K)</button>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="text-xs text-subtle">
      100% estático. Sem tracking. Feito por <a href="https://mouro.dev" target="_blank" rel="noopener noreferrer" class="footer-author-link">mouro.dev ↗</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-thin) solid var(--color-border);
    background-color: var(--color-bg-raised);
    margin-block-start: var(--space-2xl);
  }

  .footer-inner {
    max-inline-size: 1400px;
    margin-inline: auto;
    padding-inline: var(--space-s);
    padding-block: var(--space-xl);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-strong);
  }

  .footer-brand-icon {
    color: var(--color-accent);
  }

  .footer-link {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-link-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: var(--step--1);
    color: var(--color-text-muted);
    cursor: pointer;
    text-align: start;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-author-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover,
    .footer-link-btn:hover,
    .footer-author-link:hover {
      color: var(--color-text-strong);
      text-decoration: underline;
    }
  }

  .footer-bottom {
    border-block-start: var(--border-thin) solid var(--color-border);
    max-inline-size: 1400px;
    margin-inline: auto;
    padding-inline: var(--space-s);
    padding-block: var(--space-xs);
    text-align: center;
  }
</style>
