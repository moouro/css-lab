---
export type IconName =
  | 'brand'
  | 'every-layout'
  | 'css-moderno'
  | 'grid-lab'
  | 'flexbox-lab'
  | 'container-query'
  | 'components'
  | 'snippets'
  | 'cheatsheets'
  | 'design-tokens'
  | 'sun'
  | 'moon'
  | 'search'
  | 'star'
  | 'close'
  | 'arrow-right'
  | 'arrow-down'
  | 'external'
  | 'inspector';

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
---

<svg
  class:list={['ui-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'brand' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="1" />
      <line x1="9" y1="3" x2="9" y2="21" />
      <line x1="9" y1="12" x2="21" y2="12" />
    </>
  )}
  {name === 'every-layout' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="1" />
      <line x1="3" y1="9" x2="21" y2="9" />
      <line x1="10" y1="9" x2="10" y2="21" />
    </>
  )}
  {name === 'css-moderno' && (
    <>
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 12 12 17 22 12" />
      <polyline points="2 17 12 22 22 17" />
    </>
  )}
  {name === 'grid-lab' && (
    <>
      <rect x="3" y="3" width="7" height="7" rx="1" />
      <rect x="14" y="3" width="7" height="7" rx="1" />
      <rect x="3" y="14" width="7" height="7" rx="1" />
      <rect x="14" y="14" width="7" height="7" rx="1" />
    </>
  )}
  {name === 'flexbox-lab' && (
    <>
      <rect x="3" y="5" width="4" height="14" rx="1" />
      <rect x="10" y="5" width="11" height="6" rx="1" />
      <rect x="10" y="13" width="7" height="6" rx="1" />
    </>
  )}
  {name === 'container-query' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="1" />
      <polyline points="15 7 17 7 17 9" />
      <polyline points="9 17 7 17 7 15" />
      <line x1="17" y1="7" x2="13" y2="11" />
      <line x1="7" y1="17" x2="11" y2="13" />
    </>
  )}
  {name === 'components' && (
    <>
      <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" />
      <line x1="12" y1="12" x2="20" y2="7.5" />
      <line x1="12" y1="12" x2="12" y2="21" />
      <line x1="12" y1="12" x2="4" y2="7.5" />
    </>
  )}
  {name === 'snippets' && (
    <>
      <polyline points="16 18 22 12 16 6" />
      <polyline points="8 6 2 12 8 18" />
      <line x1="14" y1="4" x2="10" y2="20" />
    </>
  )}
  {name === 'cheatsheets' && (
    <>
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
      <polyline points="14 2 14 8 20 8" />
      <line x1="8" y1="13" x2="16" y2="13" />
      <line x1="8" y1="17" x2="13" y2="17" />
    </>
  )}
  {name === 'design-tokens' && (
    <>
      <line x1="4" y1="6" x2="20" y2="6" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="18" x2="20" y2="18" />
      <circle cx="9" cy="6" r="2" fill="var(--color-bg-surface)" />
      <circle cx="15" cy="12" r="2" fill="var(--color-bg-surface)" />
      <circle cx="10" cy="18" r="2" fill="var(--color-bg-surface)" />
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <line x1="12" y1="2" x2="12" y2="5" />
      <line x1="12" y1="19" x2="12" y2="22" />
      <line x1="4.93" y1="4.93" x2="7.05" y2="7.05" />
      <line x1="16.95" y1="16.95" x2="19.07" y2="19.07" />
      <line x1="2" y1="12" x2="5" y2="12" />
      <line x1="19" y1="12" x2="22" y2="12" />
      <line x1="4.93" y1="19.07" x2="7.05" y2="16.95" />
      <line x1="16.95" y1="7.05" x2="19.07" y2="4.93" />
    </>
  )}
  {name === 'moon' && (
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  )}
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </>
  )}
  {name === 'star' && (
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
  )}
  {name === 'close' && (
    <>
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </>
  )}
  {name === 'arrow-down' && (
    <>
      <line x1="12" y1="5" x2="12" y2="19" />
      <polyline points="19 12 12 19 5 12" />
    </>
  )}
  {name === 'external' && (
    <>
      <line x1="7" y1="17" x2="17" y2="7" />
      <polyline points="7 7 17 7 17 17" />
    </>
  )}
  {name === 'inspector' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="1" stroke-dasharray="3 2" />
      <line x1="9" y1="3" x2="9" y2="21" />
      <line x1="3" y1="10" x2="21" y2="10" />
    </>
  )}
</svg>

<style>
  .ui-icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
