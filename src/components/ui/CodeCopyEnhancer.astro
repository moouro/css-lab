---
// Global enhancer that injects accessible Copy buttons (Invoker Commands + fallback)
// into all <pre> code blocks rendered inside <main>.
---

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const timers = new WeakMap<HTMLButtonElement, number>();
  let snippetCounter = 0;
  let lastMessage = '';
  let listenersBound = false;

  interface InvokerCommandEvent extends Event {
    command?: string;
    source?: Element | null;
  }

  function createCopyIcon(kind: 'copy' | 'check'): SVGSVGElement {
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('width', '15');
    svg.setAttribute('height', '15');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '1.75');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');

    if (kind === 'check') {
      const polyline = document.createElementNS(SVG_NS, 'polyline');
      polyline.setAttribute('points', '20 6 9 17 4 12');
      svg.append(polyline);
      return svg;
    }

    const rect = document.createElementNS(SVG_NS, 'rect');
    rect.setAttribute('x', '9');
    rect.setAttribute('y', '9');
    rect.setAttribute('width', '13');
    rect.setAttribute('height', '13');
    rect.setAttribute('rx', '2');
    rect.setAttribute('ry', '2');

    const path = document.createElementNS(SVG_NS, 'path');
    path.setAttribute('d', 'M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1');

    svg.append(rect, path);
    return svg;
  }

  function legacyCopy(text: string): boolean {
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.cssText = 'position:fixed;inset-block-start:0;opacity:0;pointer-events:none;';
    document.body.append(field);
    field.select();
    try {
      const doc = document as unknown as { execCommand?: (cmd: string) => boolean };
      return doc.execCommand?.('copy') ?? false;
    } catch {
      return false;
    } finally {
      field.remove();
    }
  }

  function report(button: HTMLButtonElement, ok: boolean): void {
    const tip = button.nextElementSibling as HTMLElement | null;
    const prevTimer = timers.get(button);
    if (prevTimer !== undefined) {
      window.clearTimeout(prevTimer);
    }

    button.removeAttribute('data-copied');
    button.removeAttribute('data-failed');
    if (tip) {
      tip.textContent = '';
    }

    let message = ok ? 'Copiado' : 'Falha ao copiar';
    if (message === lastMessage) {
      message += '\u00A0';
    }
    lastMessage = message;

    void button.offsetWidth;
    button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
    button.replaceChildren(createCopyIcon(ok ? 'check' : 'copy'));

    if (tip) {
      requestAnimationFrame(() => {
        tip.textContent = message;
      });
    }

    const timer = window.setTimeout(() => {
      button.removeAttribute('data-copied');
      button.removeAttribute('data-failed');
      button.replaceChildren(createCopyIcon('copy'));
      if (tip) {
        tip.textContent = '';
      }
      timers.delete(button);
    }, 2000);

    timers.set(button, timer);
  }

  async function copyFromTarget(button: HTMLButtonElement, target: HTMLElement): Promise<void> {
    const text = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement
      ? target.value
      : target.innerText.trim();
    if (!text) return;

    try {
      await navigator.clipboard.writeText(text);
      report(button, true);
    } catch {
      report(button, legacyCopy(text));
    }
  }

  function nextSnippetId(): string {
    let candidate = `code-snippet-${++snippetCounter}`;
    while (document.getElementById(candidate)) {
      candidate = `code-snippet-${++snippetCounter}`;
    }
    return candidate;
  }

  function enhanceCodeBlocks(): void {
    const preElements = document.querySelectorAll<HTMLPreElement>('main pre');
    preElements.forEach((pre) => {
      if (pre.dataset.copyEnhanced === 'true') return;
      pre.dataset.copyEnhanced = 'true';

      const parent = pre.parentNode;
      if (!parent) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';
      wrapper.setAttribute('data-copy-wrapper', '');

      parent.insertBefore(wrapper, pre);
      wrapper.append(pre);

      const target = pre.querySelector<HTMLElement>('code') ?? pre;
      if (!target.id) {
        target.id = nextSnippetId();
      }

      const control = document.createElement('span');
      control.className = 'code-copy-control';
      control.setAttribute('data-pagefind-ignore', '');

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy-btn';
      button.setAttribute('command', '--copy');
      button.setAttribute('commandfor', target.id);
      button.setAttribute('aria-label', 'Copiar código');
      button.append(createCopyIcon('copy'));

      const tip = document.createElement('span');
      tip.className = 'code-copy-tip';
      tip.setAttribute('role', 'status');

      control.append(button, tip);
      wrapper.append(control);
    });
  }

  function bindCopyListeners(): void {
    if (listenersBound) return;
    listenersBound = true;

    document.addEventListener(
      'command',
      (event: Event) => {
        const cmdEvent = event as InvokerCommandEvent;
        if (cmdEvent.command !== '--copy') return;
        const source = cmdEvent.source;
        const target = cmdEvent.target;
        if (source instanceof HTMLButtonElement && target instanceof HTMLElement) {
          void copyFromTarget(source, target);
        }
      },
      true
    );

    if (!('CommandEvent' in window)) {
      document.addEventListener('click', (event: Event) => {
        const origin = event.target;
        if (!(origin instanceof Element)) return;
        const button = origin.closest<HTMLButtonElement>('button[command="--copy"]');
        if (!button) return;
        const targetId = button.getAttribute('commandfor');
        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (target) {
          void copyFromTarget(button, target);
        }
      });
    }
  }

  bindCopyListeners();
  enhanceCodeBlocks();
  document.addEventListener('astro:page-load', enhanceCodeBlocks);
</script>

<style is:global>
  .code-block-wrapper {
    position: relative;
    margin-block: var(--space-m);
    max-inline-size: 100%;
  }

  .code-block-wrapper > pre {
    margin-block: 0;
    padding-inline-end: 3.25rem;
  }

  /* Preserva a estética enquadrada do componente AntiPattern */
  .code-pane .code-block-wrapper {
    margin-block: 0;
  }

  .code-pane .code-block-wrapper > pre {
    border: none;
    border-radius: 0;
  }

  .code-copy-control {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .code-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 32px;
    min-block-size: 32px;
    padding: 0.35rem;
    border-radius: var(--radius-s);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-surface);
    color: var(--color-fg-muted);
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out),
                transform 120ms var(--ease-out);
  }

  .code-copy-btn svg {
    animation: copy-icon-in 160ms var(--ease-out);
  }

  @keyframes copy-icon-in {
    from {
      opacity: 0;
      transform: scale(0.75);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .code-copy-btn:hover {
      color: var(--color-text-strong);
      border-color: var(--color-border-hover);
      background-color: var(--color-bg-hover);
    }
  }

  .code-copy-btn[data-copied] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-muted);
  }

  .code-copy-btn[data-failed] {
    color: var(--color-danger);
    border-color: var(--color-danger);
    background-color: var(--color-danger-subtle);
  }

  .code-copy-tip {
    pointer-events: none;
    order: -1;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-s);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-strong);
    white-space: nowrap;
    opacity: 0;
    box-shadow: var(--shadow-sm);
    transition: opacity var(--duration-fast) ease;
  }

  .code-copy-btn:is([data-copied], [data-failed]) + .code-copy-tip {
    opacity: 1;
  }

  @media (hover: hover) {
    .code-block-wrapper .code-copy-btn {
      opacity: 0;
    }

    .code-block-wrapper:hover .code-copy-btn,
    .code-block-wrapper:focus-within .code-copy-btn,
    .code-copy-btn:focus-visible,
    .code-copy-btn[data-copied],
    .code-copy-btn[data-failed] {
      opacity: 1;
    }
  }

  @media (pointer: coarse) {
    .code-copy-btn {
      min-inline-size: 40px;
      min-block-size: 40px;
    }
  }

  @media print {
    .code-copy-control {
      display: none;
    }
  }
</style>
