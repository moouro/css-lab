---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { mergeVars } from '../../utils/style';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  as: Tag;
  space?: string;
  recursive?: boolean;
  splitAfter?: number;
}>;

const {
  as: Tag = 'div',
  space = 'var(--space-s)',
  recursive = false,
  splitAfter,
  class: className,
  style,
  ...rest
} = Astro.props;

const Element = Tag as 'div';
const computedStyle = mergeVars(
  {
    '--stack-space': space,
  },
  style,
);
---

<Element
  class:list={['stack', className]}
  data-recursive={recursive ? '' : undefined}
  data-split-after={splitAfter !== undefined ? String(splitAfter) : undefined}
  style={computedStyle}
  {...rest}
>
  <slot />
</Element>
