---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { mergeVars } from '../../utils/style';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  as: Tag;
  min?: string;
  space?: string;
}>;

const {
  as: Tag = 'div',
  min = '16rem',
  space = 'var(--space-s)',
  class: className,
  style,
  ...rest
} = Astro.props;

const Element = Tag as 'div';
const computedStyle = mergeVars(
  {
    '--grid-min': min,
    '--grid-space': space,
  },
  style,
);
---

<Element
  class:list={['grid', className]}
  style={computedStyle}
  {...rest}
>
  <slot />
</Element>
