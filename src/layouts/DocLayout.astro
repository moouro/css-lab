---
import BaseLayout from './BaseLayout.astro';
import SidebarLayout from '../components/layout/Sidebar.astro';
import BookmarkButton from '../components/ui/BookmarkButton.astro';
import MasteryButton from '../components/ui/MasteryButton.astro';
import UiIcon from '../components/ui/UiIcon.astro';

export interface Props {
  title: string;
  description?: string;
  collectionName?: string;
  collectionSlug?: string;
  items?: Array<{ slug: string; title: string; order?: number }>;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  tags?: string[];
  difficulty?: string;
}

const {
  title,
  description,
  collectionName = 'Every Layout',
  collectionSlug,
  items = [],
  headings = [],
  tags = [],
  difficulty
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedCurrent = currentPath.replace(/\/+$/, '') || '/';
const slugBase = collectionSlug ?? collectionName.toLowerCase().replace(/\s+/g, '-');

// Sequential pagination logic (Next / Previous article)
const currentIndex = items.findIndex((item) => {
  const itemHref = `/${slugBase}/${item.slug}`;
  return normalizedCurrent === itemHref;
});

const prevItem = currentIndex > 0 ? items[currentIndex - 1] : null;
const nextItem = currentIndex >= 0 && currentIndex < items.length - 1 ? items[currentIndex + 1] : null;
---

<BaseLayout title={title} description={description}>
  <div class="doc-container">
    <SidebarLayout sideWidth="17rem" contentMin="65%" gap="var(--space-l)">
      <!-- Left: Navigation Sidebar -->
      <aside class="doc-sidebar">
        <!-- Mobile Collapsible Accordion (Visível apenas em <= 1024px) -->
        <details class="mobile-collection-accordion">
          <summary class="mobile-collection-summary">
            <span class="mobile-collection-title">
              <UiIcon name="folder" size={15} class="collection-folder-icon" />
              <span>{collectionName} <span class="collection-count">({items.length} guias)</span></span>
            </span>
            <UiIcon name="chevron-down" size={14} class="mobile-collection-chevron" />
          </summary>
          <div class="mobile-collection-content">
            <nav aria-label="Navegação da coleção no celular">
              <ul class="nav-tree">
                {items.map((item) => {
                  const itemHref = `/${slugBase}/${item.slug}`;
                  const isActive = normalizedCurrent === itemHref;
                  return (
                    <li>
                      <a
                        href={itemHref}
                        class:list={['tree-link', { active: isActive }]}
                        aria-current={isActive ? 'page' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          </div>
        </details>

        <!-- Desktop Persistent Sticky Sidebar (Visível apenas em > 1024px) -->
        <div class="desktop-sidebar-sticky">
          <div class="sidebar-header">
            <a href={`/${slugBase}`} class="collection-back-link">
              <span class="text-xs font-semibold tracking-caps text-muted">{collectionName}</span>
              <span class="text-xs text-accent" aria-hidden="true">↗</span>
            </a>
          </div>

          <nav aria-label="Navegação da coleção">
            <ul class="nav-tree">
              {items.map((item) => {
                const itemHref = `/${slugBase}/${item.slug}`;
                const isActive = normalizedCurrent === itemHref;
                return (
                  <li>
                    <a
                      href={itemHref}
                      class:list={['tree-link', { active: isActive }]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      {item.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        </div>
      </aside>

      <!-- Center & Right: Main Content & Floating TOC -->
      <div class="doc-main-col">
        <div class="doc-content-wrapper">
          <article
            class="doc-article stack"
            style="--stack-space: var(--space-m);"
            data-pagefind-body
            data-pagefind-filter={`seção:${collectionName}`}
            data-doc-title={title}
            data-doc-url={normalizedCurrent}
            data-doc-section={collectionName}
          >
            <!-- Breadcrumbs -->
            <nav aria-label="Localização na plataforma" class="doc-breadcrumbs" data-pagefind-ignore>
              <ol class="breadcrumb-list">
                <li><a href="/" class="breadcrumb-link">Início</a></li>
                <li class="breadcrumb-sep" aria-hidden="true">/</li>
                <li><a href={`/${slugBase}`} class="breadcrumb-link">{collectionName}</a></li>
                <li class="breadcrumb-sep" aria-hidden="true">/</li>
                <li class="breadcrumb-current" aria-current="page">{title}</li>
              </ol>
            </nav>

            <header class="doc-header stack" style="--stack-space: var(--space-2xs);">
              <div class="doc-meta-bar cluster" data-pagefind-ignore style="--cluster-space: var(--space-xs); --cluster-justify: space-between; align-items: center;">
                <div class="cluster" style="--cluster-space: var(--space-3xs); --cluster-justify: flex-start; align-items: center;">
                  {difficulty && (
                    <span class="badge badge-difficulty">{difficulty}</span>
                  )}
                  {tags.map((tag) => (
                    <span class="badge badge-tag">#{tag}</span>
                  ))}
                </div>
                <div class="doc-actions cluster" style="--cluster-space: var(--space-2xs); align-items: center;">
                  <MasteryButton url={normalizedCurrent} />
                  <BookmarkButton title={title} url={normalizedCurrent} />
                </div>
              </div>
              <h1 class="doc-title">{title}</h1>
              {description && <p class="doc-desc text-lg text-muted">{description}</p>}
            </header>

            <hr class="doc-divider" />

            <!-- MDX Slot -->
            <div class="prose-content">
              <slot />
            </div>

            <hr class="doc-divider" />

            <!-- Paginação Sequencial: Anterior & Próximo -->
            <nav class="doc-pagination-nav" aria-label="Navegação sequencial de leitura" data-pagefind-ignore>
              <div class="pagination-grid">
                {prevItem ? (
                  <a href={`/${slugBase}/${prevItem.slug}`} class="pagination-card pagination-prev">
                    <span class="pagination-dir">← Anterior</span>
                    <strong class="pagination-title">{prevItem.title}</strong>
                  </a>
                ) : (
                  <a href={`/${slugBase}`} class="pagination-card pagination-hub">
                    <span class="pagination-dir">↑ Visão Geral</span>
                    <strong class="pagination-title">Hub do {collectionName}</strong>
                  </a>
                )}

                {nextItem ? (
                  <a href={`/${slugBase}/${nextItem.slug}`} class="pagination-card pagination-next">
                    <span class="pagination-dir">Próximo Guia →</span>
                    <strong class="pagination-title">{nextItem.title}</strong>
                  </a>
                ) : (
                  <a href={`/${slugBase}`} class="pagination-card pagination-hub">
                    <span class="pagination-dir">✓ Conclusão</span>
                    <strong class="pagination-title">Voltar ao {collectionName}</strong>
                  </a>
                )}
              </div>

              <!-- Quick Jump da Coleção para o final da leitura no Mobile -->
              <div class="mobile-bottom-navigator">
                <details class="mobile-collection-accordion bottom-accordion">
                  <summary class="mobile-collection-summary">
                    <span class="mobile-collection-title">
                      <UiIcon name="book-open" size={15} class="collection-folder-icon" />
                      <span>Todos os guias de {collectionName} <span class="collection-count">({currentIndex >= 0 ? `${currentIndex + 1}/${items.length}` : `${items.length} guias`})</span></span>
                    </span>
                    <UiIcon name="chevron-down" size={14} class="mobile-collection-chevron" />
                  </summary>
                  <div class="mobile-collection-content">
                    <ul class="nav-tree">
                      {items.map((item, idx) => {
                        const itemHref = `/${slugBase}/${item.slug}`;
                        const isActive = normalizedCurrent === itemHref;
                        return (
                          <li>
                            <a
                              href={itemHref}
                              class:list={['tree-link', { active: isActive }]}
                              aria-current={isActive ? 'page' : undefined}
                            >
                              <span class="quick-nav-num">#{String(idx + 1).padStart(2, '0')}</span>
                              <span>{item.title}</span>
                              {isActive && <span class="current-pill">Lendo agora</span>}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </details>
              </div>
            </nav>
          </article>

          <!-- Floating TOC (if headings exist) -->
          {headings.length > 0 && (
            <aside class="doc-toc">
              <div class="toc-sticky stack" style="--stack-space: var(--space-xs);">
                <span class="text-xs font-semibold tracking-caps text-muted">Nesta página</span>
                <nav class="toc-nav" aria-label="Sumário da página">
                  <ul class="toc-list">
                    {headings.filter(h => h.depth <= 3).map((h) => (
                      <li class="toc-item" data-depth={h.depth}>
                        <a href={`#${h.slug}`} class="toc-link">
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            </aside>
          )}
        </div>
      </div>
    </SidebarLayout>
  </div>
</BaseLayout>

<script>
  const RECENT_STORAGE_KEY = 'css-lab-recent';
  let cleanupTocSpy: (() => void) | null = null;
  let docLayoutListenersBound = false;

  interface RecentItem {
    title: string;
    url: string;
    section: string;
  }

  interface TocEntry {
    link: HTMLAnchorElement;
    heading: HTMLElement;
  }

  function isValidRecent(item: unknown): item is RecentItem {
    if (!item || typeof item !== 'object') return false;
    const candidate = item as Record<string, unknown>;
    return (
      typeof candidate.url === 'string' &&
      candidate.url.startsWith('/') &&
      !candidate.url.startsWith('//') &&
      typeof candidate.title === 'string' &&
      typeof candidate.section === 'string'
    );
  }

  function recordRecentDoc(): void {
    const article = document.querySelector<HTMLElement>('.doc-article[data-doc-url]');
    if (!article) return;

    const url = article.getAttribute('data-doc-url') || '';
    const title = article.getAttribute('data-doc-title') || '';
    const section = article.getAttribute('data-doc-section') || '';
    if (!url.startsWith('/') || url.startsWith('//') || !title) return;

    try {
      const raw = localStorage.getItem(RECENT_STORAGE_KEY);
      const parsed: unknown = raw ? JSON.parse(raw) : [];
      const existing = Array.isArray(parsed) ? parsed.filter(isValidRecent) : [];
      const updated: RecentItem[] = [
        { title, url, section },
        ...existing.filter((entry) => entry.url !== url),
      ].slice(0, 3);
      localStorage.setItem(RECENT_STORAGE_KEY, JSON.stringify(updated));
    } catch {
      // Storage indisponível
    }
  }

  function initTocScrollSpy(): void {
    cleanupTocSpy?.();
    cleanupTocSpy = null;

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.doc-toc .toc-link'));
    if (links.length === 0) return;

    const entries: TocEntry[] = [];
    for (const link of links) {
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) continue;
      let targetId = href.slice(1);
      try {
        targetId = decodeURIComponent(targetId);
      } catch {
        // Mantém slug bruto se houver caractere inválido
      }
      const heading = document.getElementById(targetId);
      if (heading) {
        if (!heading.hasAttribute('tabindex')) {
          heading.setAttribute('tabindex', '-1');
        }
        entries.push({ link, heading });
      }
    }

    if (entries.length === 0) return;

    const supportsScrollTargetGroup =
      typeof CSS !== 'undefined' && CSS.supports('scroll-target-group: auto');

    const keepTocLinkVisible = (link: HTMLAnchorElement | null | undefined): void => {
      if (!link) return;
      const container = link.closest<HTMLElement>('.toc-sticky');
      if (!container || container.scrollHeight <= container.clientHeight) return;

      const linkTop = link.offsetTop;
      const linkBottom = linkTop + link.offsetHeight;
      if (linkTop < container.scrollTop) {
        container.scrollTop = linkTop;
      } else if (linkBottom > container.scrollTop + container.clientHeight) {
        container.scrollTop = linkBottom - container.clientHeight;
      }
    };

    if (supportsScrollTargetGroup) {
      const syncNativeAria = (): void => {
        const activeLink = document.querySelector<HTMLAnchorElement>('.doc-toc .toc-link:target-current');
        for (const { link } of entries) {
          link.setAttribute('aria-current', link === activeLink ? 'true' : 'false');
        }
        keepTocLinkVisible(activeLink);
      };

      syncNativeAria();
      document.addEventListener('scrollend', syncNativeAria);
      cleanupTocSpy = () => {
        document.removeEventListener('scrollend', syncNativeAria);
      };
      return;
    }

    let rafId: number | null = null;

    const updateActiveFallback = (): void => {
      const scrollBottom = window.innerHeight + window.scrollY;
      const docHeight = document.documentElement.scrollHeight;
      let activeIndex = 0;

      if (docHeight > window.innerHeight && scrollBottom >= docHeight - 24) {
        activeIndex = entries.length - 1;
      } else {
        for (let i = 0; i < entries.length; i++) {
          const rect = entries[i].heading.getBoundingClientRect();
          if (rect.top <= 128) {
            activeIndex = i;
          } else {
            break;
          }
        }
      }

      entries.forEach(({ link }, idx) => {
        const isActive = idx === activeIndex;
        link.classList.toggle('target-current', isActive);
        link.setAttribute('aria-current', isActive ? 'true' : 'false');
      });

      keepTocLinkVisible(entries[activeIndex]?.link);
    };

    const scheduleFallbackUpdate = (): void => {
      if (rafId !== null) return;
      rafId = window.requestAnimationFrame(() => {
        rafId = null;
        updateActiveFallback();
      });
    };

    const observer = new IntersectionObserver(
      () => {
        scheduleFallbackUpdate();
      },
      { rootMargin: '-12% 0px -65% 0px', threshold: 0 }
    );

    for (const { heading } of entries) {
      observer.observe(heading);
    }

    updateActiveFallback();
    window.addEventListener('scroll', scheduleFallbackUpdate, { passive: true });
    window.addEventListener('resize', scheduleFallbackUpdate, { passive: true });

    cleanupTocSpy = () => {
      observer.disconnect();
      window.removeEventListener('scroll', scheduleFallbackUpdate);
      window.removeEventListener('resize', scheduleFallbackUpdate);
      if (rafId !== null) {
        window.cancelAnimationFrame(rafId);
        rafId = null;
      }
    };
  }

  function handleDocPageLoad(): void {
    recordRecentDoc();
    initTocScrollSpy();
  }

  if (!docLayoutListenersBound) {
    docLayoutListenersBound = true;
    document.addEventListener('astro:page-load', handleDocPageLoad);
    document.addEventListener('astro:before-swap', () => {
      cleanupTocSpy?.();
      cleanupTocSpy = null;
    });
  }

  handleDocPageLoad();
</script>

<style>
  .doc-container {
    max-inline-size: 1440px;
    margin-inline: auto;
    padding-inline: var(--space-s);
    padding-block: var(--space-m);
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  /* Desktop Sticky Sidebar */
  .desktop-sidebar-sticky {
    position: sticky;
    inset-block-start: calc(var(--space-xl) + 2rem);
    max-block-size: calc(100dvh - 6rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .doc-sidebar {
    border-inline-end: 1px solid var(--color-border);
    padding-inline-end: var(--space-m);
  }

  .sidebar-header {
    margin-block-end: var(--space-2xs);
  }

  .collection-back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .collection-back-link:hover {
      opacity: 0.8;
    }
  }

  .nav-tree {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tree-link {
    display: block;
    font-size: var(--step--1);
    color: var(--color-fg-muted);
    padding-inline: var(--space-xs);
    padding-block: 0.35rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color var(--duration-fast), background-color var(--duration-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .tree-link:hover {
      color: var(--color-fg);
      background-color: var(--color-bg-hover);
      text-decoration: none;
    }
  }

  .tree-link.active {
    color: var(--color-accent);
    background-color: var(--color-accent-muted);
    font-weight: 600;
  }

  /* Mobile Collapsible Accordion */
  .mobile-collection-accordion {
    display: none;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-sm);
    margin-block-end: 0;
  }

  :global(.collection-folder-icon) {
    color: var(--color-accent);
  }

  .mobile-collection-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-s);
    cursor: pointer;
    user-select: none;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-fg);
    list-style: none;
  }

  .mobile-collection-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-collection-title {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .collection-count {
    font-size: var(--step--2);
    font-weight: normal;
    color: var(--color-fg-muted);
  }

  .mobile-collection-chevron {
    transition: transform var(--duration-fast);
    color: var(--color-fg-muted);
  }

  .mobile-collection-accordion[open] .mobile-collection-chevron {
    transform: rotate(180deg);
  }

  .mobile-collection-content {
    padding: var(--space-xs) var(--space-s) var(--space-s);
    border-block-start: 1px solid var(--color-border-subtle);
    max-block-size: 50vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Breadcrumbs */
  .doc-breadcrumbs {
    margin-block-end: var(--space-2xs);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--2);
    font-family: var(--font-mono);
  }

  .breadcrumb-link {
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .breadcrumb-link:hover {
      color: var(--color-accent);
    }
  }

  .breadcrumb-sep {
    color: var(--color-fg-subtle);
  }

  .breadcrumb-current {
    color: var(--color-fg);
    font-weight: 600;
  }

  .doc-main-col {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .doc-article {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .doc-content-wrapper {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: var(--space-xl);
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  @media (max-width: 1080px) {
    .doc-content-wrapper {
      grid-template-columns: minmax(0, 1fr);
    }
    .doc-toc {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .doc-container :global(.with-sidebar) {
      display: flex;
      flex-direction: column !important;
      gap: var(--space-xs) !important;
    }

    .doc-container :global(.with-sidebar > :first-child),
    .doc-container :global(.with-sidebar > :last-child) {
      flex-basis: auto !important;
      min-inline-size: 0 !important;
      max-inline-size: 100% !important;
      inline-size: 100% !important;
    }

    .doc-sidebar {
      border-inline-end: none;
      padding-inline-end: 0;
      border-block-end: none;
      padding-block-end: var(--space-xs);
      margin-block-end: 0;
      inline-size: 100%;
    }

    .desktop-sidebar-sticky {
      display: none;
    }

    .mobile-collection-accordion {
      display: block;
      inline-size: 100%;
    }
  }

  .doc-title {
    font-size: var(--step-4);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .doc-divider {
    border: none;
    border-block-start: 1px solid var(--color-border);
    margin-block: var(--space-xs);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    padding-inline: 0.6em;
    padding-block: 0.18em;
    border-radius: var(--radius-full);
  }

  .badge-difficulty {
    background-color: var(--color-bg-inset);
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    text-transform: capitalize;
  }

  .badge-tag {
    color: var(--color-fg-muted);
    background-color: var(--color-bg-inset);
  }

  .toc-sticky {
    position: sticky;
    inset-block-start: calc(var(--space-xl) + 2rem);
    max-block-size: calc(100dvh - 6rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .toc-nav {
    scroll-target-group: auto;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-inline-start: 1px solid var(--color-border);
  }

  .toc-link {
    display: block;
    font-size: var(--step--2);
    color: var(--color-fg-muted);
    text-decoration: none;
    line-height: 1.38;
    padding-block: 0.32rem;
    padding-inline-start: 0.85rem;
    margin-inline-start: -1px;
    border-inline-start: 2px solid transparent;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .toc-item[data-depth="3"] .toc-link {
    padding-inline-start: 1.55rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .toc-link:hover {
      color: var(--color-text-strong);
      text-decoration: none;
    }
  }

  /* MANDATORY scrollspy rule: use :is() so unrecognized :target-current never invalidates fallback .target-current */
  .toc-link:is(:target-current, .target-current) {
    color: var(--color-accent);
    border-inline-start-color: var(--color-accent);
    font-weight: 600;
  }

  .prose-content {
    line-height: var(--leading-relaxed);
    min-inline-size: 0;
    max-inline-size: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .prose-content :global(:is(h2, h3)) {
    scroll-margin-block-start: 5.5rem;
  }

  .prose-content :global(pre) {
    max-inline-size: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prose-content :global(table) {
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prose-content :global(h2) {
    margin-block-start: var(--space-xl);
    margin-block-end: var(--space-xs);
    border-block-end: 1px solid var(--color-border);
    padding-block-end: var(--space-3xs);
    font-size: var(--step-2);
  }

  .prose-content :global(h3) {
