---
import BaseLayout from './BaseLayout.astro';
import SidebarLayout from '../components/layout/Sidebar.astro';
import BookmarkButton from '../components/ui/BookmarkButton.astro';

export interface Props {
  title: string;
  description?: string;
  collectionName?: string;
  collectionSlug?: string;
  items?: Array<{ slug: string; title: string; order?: number }>;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  tags?: string[];
  difficulty?: string;
}

const {
  title,
  description,
  collectionName = 'Every Layout',
  collectionSlug,
  items = [],
  headings = [],
  tags = [],
  difficulty
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedCurrent = currentPath.replace(/\/+$/, '') || '/';
const slugBase = collectionSlug ?? collectionName.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout title={title} description={description}>
  <div class="doc-container">
    <SidebarLayout sideWidth="17rem" contentMin="65%" gap="var(--space-l)">
      <!-- Left: Navigation Sidebar -->
      <aside class="doc-sidebar">
        <!-- Mobile Collapsible Accordion (Visível apenas em <= 1024px) -->
        <details class="mobile-collection-accordion">
          <summary class="mobile-collection-summary">
            <span class="mobile-collection-title">
              <span class="collection-folder-icon" aria-hidden="true">📁</span>
              <span>{collectionName} <span class="collection-count">({items.length} guias)</span></span>
            </span>
            <span class="mobile-collection-chevron" aria-hidden="true">▾</span>
          </summary>
          <div class="mobile-collection-content">
            <nav aria-label="Navegação da coleção no celular">
              <ul class="nav-tree">
                {items.map((item) => {
                  const itemHref = `/${slugBase}/${item.slug}`;
                  const isActive = normalizedCurrent === itemHref;
                  return (
                    <li>
                      <a
                        href={itemHref}
                        class:list={['tree-link', { active: isActive }]}
                        aria-current={isActive ? 'page' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          </div>
        </details>

        <!-- Desktop Persistent Sticky Sidebar (Visível apenas em > 1024px) -->
        <div class="desktop-sidebar-sticky">
          <div class="sidebar-header">
            <a href={`/${slugBase}`} class="collection-back-link">
              <span class="text-xs font-semibold tracking-caps text-muted">{collectionName}</span>
              <span class="text-xs text-accent" aria-hidden="true">↗</span>
            </a>
          </div>

          <nav aria-label="Navegação da coleção">
            <ul class="nav-tree">
              {items.map((item) => {
                const itemHref = `/${slugBase}/${item.slug}`;
                const isActive = normalizedCurrent === itemHref;
                return (
                  <li>
                    <a
                      href={itemHref}
                      class:list={['tree-link', { active: isActive }]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      {item.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        </div>
      </aside>

      <!-- Center & Right: Main Content & Floating TOC -->
      <div class="doc-main-col">
        <div class="doc-content-wrapper">
          <article 
            class="doc-article stack" 
            style="--stack-space: var(--space-m);"
            data-pagefind-body
            data-pagefind-filter={`seção:${collectionName}`}
          >
            <!-- Breadcrumbs -->
            <nav aria-label="Localização na plataforma" class="doc-breadcrumbs">
              <ol class="breadcrumb-list">
                <li><a href="/" class="breadcrumb-link">Início</a></li>
                <li class="breadcrumb-sep" aria-hidden="true">/</li>
                <li><a href={`/${slugBase}`} class="breadcrumb-link">{collectionName}</a></li>
                <li class="breadcrumb-sep" aria-hidden="true">/</li>
                <li class="breadcrumb-current" aria-current="page">{title}</li>
              </ol>
            </nav>

            <header class="doc-header stack" style="--stack-space: var(--space-2xs);">
              <div class="cluster" style="--cluster-space: var(--space-xs); --cluster-justify: space-between; align-items: center;">
                <div class="cluster" style="--cluster-space: var(--space-3xs); align-items: center;">
                  {difficulty && (
                    <span class="badge badge-difficulty">{difficulty}</span>
                  )}
                  {tags.map((tag) => (
                    <span class="badge badge-tag">#{tag}</span>
                  ))}
                </div>
                <BookmarkButton title={title} url={normalizedCurrent} />
              </div>
              <h1 class="doc-title">{title}</h1>
              {description && <p class="doc-desc text-lg text-muted">{description}</p>}
            </header>

            <hr class="doc-divider" />

            <!-- MDX Slot -->
            <div class="prose-content">
              <slot />
            </div>
          </article>

          <!-- Floating TOC (if headings exist) -->
          {headings.length > 0 && (
            <aside class="doc-toc">
              <div class="toc-sticky stack" style="--stack-space: var(--space-xs);">
                <span class="text-xs font-semibold tracking-caps text-muted">Nesta página</span>
                <nav aria-label="Sumário da página">
                  <ul class="toc-list stack" style="--stack-space: var(--space-3xs);">
                    {headings.filter(h => h.depth <= 3).map((h) => (
                      <li style={{ paddingInlineStart: `${(h.depth - 2) * 0.75}rem` }}>
                        <a href={`#${h.slug}`} class="toc-link">
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            </aside>
          )}
        </div>
      </div>
    </SidebarLayout>
  </div>
</BaseLayout>

<style>
  .doc-container {
    max-inline-size: 1440px;
    margin-inline: auto;
    padding-inline: var(--space-s);
    padding-block: var(--space-m);
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  /* Desktop Sticky Sidebar */
  .desktop-sidebar-sticky {
    position: sticky;
    inset-block-start: calc(var(--space-xl) + 2rem);
    max-block-size: calc(100dvh - 6rem);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .doc-sidebar {
    border-inline-end: 1px solid var(--color-border);
    padding-inline-end: var(--space-m);
  }

  .sidebar-header {
    margin-block-end: var(--space-2xs);
  }

  .collection-back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }

  .collection-back-link:hover {
    opacity: 0.8;
  }

  .nav-tree {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tree-link {
    display: block;
    font-size: var(--step--1);
    color: var(--color-fg-muted);
    padding-inline: var(--space-xs);
    padding-block: 0.35rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color var(--duration-fast), background-color var(--duration-fast);
  }

  .tree-link:hover {
    color: var(--color-fg);
    background-color: var(--color-bg-hover);
    text-decoration: none;
  }

  .tree-link.active {
    color: var(--color-accent);
    background-color: var(--color-accent-muted);
    font-weight: 600;
  }

  /* Mobile Collapsible Accordion */
  .mobile-collection-accordion {
    display: none;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-block-end: var(--space-m);
  }

  .mobile-collection-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-s);
    cursor: pointer;
    user-select: none;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-fg);
    list-style: none;
  }

  .mobile-collection-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-collection-title {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .collection-count {
    font-size: var(--step--2);
    font-weight: normal;
    color: var(--color-fg-muted);
  }

  .mobile-collection-chevron {
    transition: transform var(--duration-fast);
    color: var(--color-fg-muted);
  }

  .mobile-collection-accordion[open] .mobile-collection-chevron {
    transform: rotate(180deg);
  }

  .mobile-collection-content {
    padding: var(--space-xs) var(--space-s) var(--space-s);
    border-block-start: 1px solid var(--color-border-subtle);
    max-block-size: 50vh;
    overflow-y: auto;
  }

  /* Breadcrumbs */
  .doc-breadcrumbs {
    margin-block-end: var(--space-2xs);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--2);
    font-family: var(--font-mono);
  }

  .breadcrumb-link {
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .breadcrumb-link:hover {
    color: var(--color-accent);
  }

  .breadcrumb-sep {
    color: var(--color-fg-subtle);
  }

  .breadcrumb-current {
    color: var(--color-fg);
    font-weight: 600;
  }

  .doc-main-col {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .doc-article {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .doc-content-wrapper {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: var(--space-xl);
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  @media (max-width: 1080px) {
    .doc-content-wrapper {
      grid-template-columns: minmax(0, 1fr);
    }
    .doc-toc {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .doc-container :global(.with-sidebar) {
      display: flex;
      flex-direction: column !important;
      gap: var(--space-m) !important;
    }

    .doc-container :global(.with-sidebar > :first-child),
    .doc-container :global(.with-sidebar > :last-child) {
      flex-basis: auto !important;
      min-inline-size: 0 !important;
      max-inline-size: 100% !important;
      inline-size: 100% !important;
    }

    .doc-sidebar {
      border-inline-end: none;
      padding-inline-end: 0;
      border-block-end: 1px solid var(--color-border);
      padding-block-end: var(--space-s);
      margin-block-end: var(--space-s);
      inline-size: 100%;
    }

    .desktop-sidebar-sticky {
      display: none;
    }

    .mobile-collection-accordion {
      display: block;
      inline-size: 100%;
    }
  }

  .doc-title {
    font-size: var(--step-4);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .doc-divider {
    border: none;
    border-block-start: 1px solid var(--color-border);
    margin-block: var(--space-xs);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    padding-inline: 0.45em;
    padding-block: 0.15em;
    border-radius: var(--radius-sm);
  }

  .badge-difficulty {
    background-color: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    text-transform: capitalize;
  }

  .badge-tag {
    color: var(--color-fg-muted);
    background-color: var(--color-bg-hover);
  }

  .toc-sticky {
    position: sticky;
    inset-block-start: calc(var(--space-xl) + 2rem);
    max-block-size: calc(100dvh - 6rem);
    overflow-y: auto;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-link {
    font-size: var(--step--2);
    color: var(--color-fg-muted);
    text-decoration: none;
    line-height: var(--leading-snug);
  }

  .toc-link:hover {
    color: var(--color-fg);
    text-decoration: underline;
  }

  .prose-content {
    line-height: var(--leading-relaxed);
    min-inline-size: 0;
    max-inline-size: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .prose-content :global(pre) {
    max-inline-size: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prose-content :global(table) {
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prose-content :global(h2) {
    margin-block-start: var(--space-xl);
    margin-block-end: var(--space-xs);
    border-block-end: 1px solid var(--color-border);
    padding-block-end: var(--space-3xs);
    font-size: var(--step-2);
  }

  .prose-content :global(h3) {
    margin-block-start: var(--space-l);
    margin-block-end: var(--space-2xs);
    font-size: var(--step-1);
  }

  .prose-content :global(p) {
    margin-block: var(--space-xs);
  }
</style>
